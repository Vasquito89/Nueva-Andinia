<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/StyleSheets/SliderSound.uss?fileID=7433441132597879392&amp;guid=8739e30b27c50a54fa333e6ce008bdf8&amp;type=3#SliderSound"/>
    <Style src="project://database/Assets/UI%20Toolkit/StyleSheets/ButtonMenu.uss?fileID=7433441132597879392&amp;guid=aba63672b70c9d643bd802336be2d4bb&amp;type=3#ButtonMenu"/>
    <Style src="project://database/Assets/UI%20Toolkit/StyleSheets/DropdownPantalla.uss?fileID=7433441132597879392&amp;guid=e88b985e2c60c2946b1c08fdf3a95886&amp;type=3#DropdownPantalla"/>
    <ui:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Game/Sprite/Menu%20Audio.png?fileID=2800000&amp;guid=162ad6d4886896440aa54f011f267e25&amp;type=3#Menu Audio&quot;);">
        <ui:VisualElement name="OptionVE">
            <ui:ScrollView name="OptionScrollView" style="position: absolute; top: 458px; left: 609px; height: 233px; width: 372px; align-self: auto;">
                <ui:Button text="pantalla" name="DisplayButton" class="Select" style="font-size: 28px; left: 30px;"/>
                <ui:Button text="audio" name="AudioButton" class="Select" style="font-size: 28px; left: 30px; top: 20px;"/>
            </ui:ScrollView>
            <ui:Label text="Opciones" style="position: absolute; top: 55px; left: 310px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/PermanentMarker-Regular.ttf?fileID=12800000&amp;guid=b72f2d41ab5cfb646b358592981724e0&amp;type=3#PermanentMarker-Regular&quot;); color: rgb(255, 255, 255); font-size: 38px;"/>
            <ui:Label text="[ESC] para salir" style="position: absolute; top: 700px; left: 53px; font-size: 38px; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/BebasNeue-Regular.ttf?fileID=12800000&amp;guid=e92794c5e8db32e469836442938636dc&amp;type=3#BebasNeue-Regular&quot;);"/>
        </ui:VisualElement>
        <ui:VisualElement name="AudioVE" style="display: none;">
            <ui:Label text="Opciones de Audio" style="position: absolute; top: 25px; left: 61px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/PermanentMarker-Regular.ttf?fileID=12800000&amp;guid=b72f2d41ab5cfb646b358592981724e0&amp;type=3#PermanentMarker-Regular&quot;); color: rgb(255, 255, 255); width: 431px; font-size: 38px;"/>
            <ui:ScrollView name="AudioScrollView" style="position: absolute; height: 372px; width: 575px; top: 153px; left: 64px;">
                <ui:Slider label="Sonido General" value="42" high-value="100" name="SoundGralSlider" low-value="-80" fill="false" class="SelectSlider"/>
                <ui:Slider label="Menu Principal" value="42" high-value="20" name="MenuPralSlider" low-value="-80" class="SelectSlider"/>
                <ui:Slider label="Sonido FX" value="42" high-value="20" name="SoundFXSlider" low-value="-80" class="SelectSlider"/>
                <ui:Toggle label="Silenciar" name="MuteToggle" class="SelectSlider"/>
                <ui:Button text="Aceptar" name="AcceptButton" class="Select" style="position: absolute; top: 297px; left: 15px; font-size: 32px;"/>
            </ui:ScrollView>
            <ui:Label text="[Esc] para salir" style="position: absolute; top: 701px; left: 98px; color: rgb(245, 245, 245); -unity-font-definition: url(&quot;project://database/Assets/Fonts/BebasNeue-Regular.ttf?fileID=12800000&amp;guid=e92794c5e8db32e469836442938636dc&amp;type=3#BebasNeue-Regular&quot;); width: 231px; font-size: 32px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="PantallaVE" style="flex-grow: 1; display: none;">
            <ui:Label text="pantalla" style="position: absolute; top: 88px; left: 315px; font-size: 40px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/PermanentMarker-Regular.ttf?fileID=12800000&amp;guid=b72f2d41ab5cfb646b358592981724e0&amp;type=3#PermanentMarker-Regular&quot;); color: rgb(7, 7, 7);"/>
            <ui:ScrollView name="PantallaScrollView" style="position: absolute; top: 232px; left: 162px; width: 749px; height: 428px;">
                <ui:DropdownField label="Resolucion" name="ResolutionDropdown"/>
                <ui:DropdownField label="Modo de pantalla" name="ScreenModeDropdown"/>
                <ui:DropdownField label="Calidad Grafica" name="QualityDropdown"/>
                <ui:DropdownField label="FPS" name="TargetFpsDropdown"/>
                <ui:Toggle label="Vsync" name="VSyncToggle"/>
                <ui:Button text="aceptar" name="ScreenButton" class="Select" style="position: absolute; top: 354px; left: 16px; font-size: 30px;"/>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
