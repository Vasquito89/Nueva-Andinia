.selection {
    width: 300px;
    height: 50px;
    font-size: 33px;
    -unity-font-definition: url("project://database/Assets/Fonts/Rajdhani-Bold.ttf?fileID=12800000&guid=41cab5b33fc4adf44ad20557f90cc09e&type=3#Rajdhani-Bold");
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
    transition-duration: 0.25s;
    background-color: rgb(140, 140, 140);
}

.selection:focus {
    background-color: rgb(139, 209, 207);
    width: 350px;
    height: 70px;
    font-size: 38px;
}
