.selection {
    width: 300px;
    height: 50px;
    font-size: 33px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=c1df4fbd62a23834c920fdcf264661f3&type=3#NotInter-Regular");
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
    transition-duration: 0.25s;
    background-color: rgb(140, 140, 140);
}

.selection:focus {
    background-color: rgb(139, 209, 207);
    width: 350px;
    height: 70px;
    font-size: 38px;
}
