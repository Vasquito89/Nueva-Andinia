.animationVE {
    background-image: url("project://database/Assets/Game/Sprite/Fondo%20Menu%20Compu.png?fileID=2800000&guid=f19ec54051b26ee4785d01e4880e3f6a&type=3#Fondo Menu Compu");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    scale: 1 1;
    translate: 0 0;
    transition-property: scale, translate, -unity-background-image-tint-color;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out;
}

.animationVE--reducido {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.5);
    scale: 0.25 0.25;
    translate: 630px 0;
    background-image: url("project://database/Assets/Game/Sprite/Fondo%20Menu%20Compu.png?fileID=2800000&guid=f19ec54051b26ee4785d01e4880e3f6a&type=3#Fondo Menu Compu");
}
