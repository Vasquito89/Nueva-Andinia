--- !u!114 &1338788943
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1338788942}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f8bd077cc6baf0949857b2d38b542f57, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SubtitleFinalScene
  uiDocument: {fileID: 0}
  labelName: TextLbl
  subtitles:
  - text: "A\xD1O 2080 "
    textColor: {r: 0.764151, g: 0.764151, b: 0.764151, a: 1}
    sizeText: 40
    displayDuration: 0.3
    showSimultaneouslyWithNext: 1
  - text: "El agua potable es el recurso m\xE1s valioso del planeta. "
    textColor: {r: 0.764151, g: 0.764151, b: 0.764151, a: 1}
    sizeText: 35
    displayDuration: 0.3
    showSimultaneouslyWithNext: 1
  - text: "Tras d\xE9cadas de crisis clim\xE1tica y guerras por recursos, las corporaciones  "
    textColor: {r: 0.764151, g: 0.764151, b: 0.764151, a: 1}
    sizeText: 35
    displayDuration: 0.3
    showSimultaneouslyWithNext: 1
  - text: "reemplazaron a los Estados. En Sudam\xE9rica, Helix Global Authority ocup\xF3  "
    textColor: {r: 0.764151, g: 0.764151, b: 0.764151, a: 1}
    sizeText: 35
    displayDuration: 0.3
    showSimultaneouslyWithNext: 1
  - text: "gran parte del territorio argentino y fund\xF3 un nuevo pa\xEDs: Nueva
      Andinia. "
    textColor: {r: 0.764151, g: 0.764151, b: 0.764151, a: 1}
    sizeText: 35
    displayDuration: 0.3
    showSimultaneouslyWithNext: 1
  - text: "Al norte, resiste la Confederaci\xF3n del Norte, el \xFAltimo basti\xF3n
      que"
    textColor: {r: 0.764151, g: 0.764151, b: 0.764151, a: 1}
    sizeText: 35
    displayDuration: 0.3
    showSimultaneouslyWithNext: 1
  - text: ' mantiene viva la identidad argentina.'
    textColor: {r: 0.764151, g: 0.764151, b: 0.764151, a: 1}
    sizeText: 35
    displayDuration: 0.3
    showSimultaneouslyWithNext: 0
  - text: "Eres Lautaro Quiroga... un Agente de inteligencia de la Confederaci\xF3n
      del Norte. "
    textColor: {r: 0.764151, g: 0.764151, b: 0.764151, a: 1}
    sizeText: 35
    displayDuration: 0.3
    showSimultaneouslyWithNext: 1
  - text: "Tu misi\xF3n exige abandonar tu identidad, cruzar territorio hostil y "
    textColor: {r: 0.764151, g: 0.764151, b: 0.764151, a: 1}
    sizeText: 35
    displayDuration: 0.3
    showSimultaneouslyWithNext: 1
  - text: 'sobrevivir en un mundo donde cada ciudadano es vigilado, registrado y
      clasificado. '
    textColor: {r: 0.764151, g: 0.764151, b: 0.764151, a: 1}
    sizeText: 35
    displayDuration: 0.3
    showSimultaneouslyWithNext: 0
  typewriterSpeed: 0.04
  fadeOutDuration: 0.02
